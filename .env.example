# Telegram API Credentials (from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Target Channel or Group (Public @username or private chat ID like -1001234567890)
TARGET_CHAT=@YourGroupOrChannel

# Automatically post attendance report and CSV when stream ends (True / False)
AUTO_POST_REPORT=True
AUTO_POST_TO_GROUP=False
ADMIN_CHAT_ID=@YourUsername

# Directory settings
CSV_OUTPUT_DIR=reports
RECORDINGS_DIR=recordings
TRANSCRIPTS_DIR=transcripts

# --- AI Transcription & Audio Processing ---
# Default engine: gemini (Recommended), groq, openai, faster_whisper
TRANSCRIPTION_ENGINE=gemini

# Primary AI Key (Google Gemini API - get free key at https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# Fallback AI Keys (Optional)
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...

# Enable live call audio capture (True / False)
ENABLE_AUDIO_RECORDING=True
